<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Eugénie Berthon — Social media manager / Monteuse</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0b;--tx:#fafafa;--mut:#8b8d98;--line:#1c1f26;--f-d:'Bebas Neue','Impact',sans-serif;--f-b:'Inter',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--tx);font-family:var(--f-b);font-weight:300;line-height:1.6}
section{padding:120px 8vw;position:relative}
.label{color:var(--mut);letter-spacing:.14em;font-size:14px;text-transform:uppercase}
.label.bar::after{content:"";display:block;width:36px;height:1px;background:var(--mut);margin-top:12px}
h2{font-family:var(--f-d);font-weight:400;font-size:clamp(72px,11vw,170px);line-height:.92;margin:40px 0 70px;text-transform:uppercase}
nav{position:fixed;right:32px;bottom:32px;z-index:10;display:flex;flex-direction:column;gap:14px;text-align:right;font-weight:400;font-size:15px}
nav.top{top:28px;bottom:auto}
nav a{color:var(--tx);text-decoration:none;padding-bottom:2px;border-bottom:1px solid transparent}
nav a.on{border-color:var(--tx)}
/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:12vh;
 background:linear-gradient(90deg,rgba(10,10,11,.85),rgba(10,10,11,.2)),url("photo-portrait.jpg") center/cover,#111;filter:none}
#hero h1{font-family:var(--f-d);font-weight:400;font-size:clamp(70px,14vw,230px);line-height:.9}
#hero h3{font-weight:400;font-size:clamp(20px,2.6vw,38px);text-transform:uppercase;margin:8px 0 40px}
#hero p{max-width:460px;color:#d5d6dc;font-size:19px}
/* ABOUT */
.about p{font-size:clamp(20px,2vw,28px);max-width:1000px;line-height:1.7;margin:40px 0 80px}
.quote{font-family:var(--f-d);font-size:clamp(60px,9vw,150px);line-height:.95;color:#d2d4dc;max-width:1000px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:80px}
.two p{margin:12px 0 0;font-size:19px}
/* SKILLS */
.skills{display:grid;grid-template-columns:1fr 1fr;column-gap:8vw}
.skills div{font-size:clamp(20px,2.2vw,32px);padding:34px 0;border-bottom:1px solid var(--line);color:#dcdde3}
/* WORK */
.job{display:grid;grid-template-columns:1.2fr .6fr 1.4fr;gap:40px;padding:60px 0;border-top:1px solid var(--line)}
.job:last-child{border-bottom:1px solid var(--line)}
.job h4{font-weight:400;font-size:clamp(28px,3.4vw,52px);line-height:1.1}
.job .co{font-size:24px;color:#b7b9c4;margin-top:14px}
.job .loc{color:#5d606c;margin-top:8px}
.job .date{color:var(--mut);letter-spacing:.14em;font-size:15px}
.job p{color:#b7b9c4;font-size:18px;line-height:1.7}
.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.tags span{border:1px solid #262a33;border-radius:99px;padding:5px 18px;font-size:14px;color:var(--mut)}
/* PROJETS */
.intro{max-width:820px;color:#a6a8b3;font-size:20px;margin:-30px 0 70px}
.serie{margin-bottom:80px}
.serie h5{font-weight:400;font-size:15px;letter-spacing:.12em;color:var(--mut);text-transform:uppercase;margin-bottom:28px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:24px}
.card figure{aspect-ratio:9/16;background:#15171c;border:1px dashed #2c303a;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#4a4e5a;font-size:14px;text-align:center;padding:20px}
.card.h figure{aspect-ratio:16/9}
.card img,.card video,.card iframe{width:100%;height:100%;object-fit:cover;border:0;display:block}
.card figcaption{color:var(--mut);font-size:14px;margin-top:12px;line-height:1.5}
/* EDUCATION */
.edu{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:50px 0}
.edu .label{padding-top:12px}
.edu h4{font-weight:400;font-size:clamp(26px,2.8vw,42px);line-height:1.2}
.edu p{color:#a6a8b3;font-size:18px;margin:22px 0}
.edu small{color:var(--mut);font-size:16px}
footer{padding:80px 8vw;color:var(--mut);font-size:15px}
footer a{color:var(--tx)}
@media(max-width:800px){
 section{padding:90px 6vw}
 .job,.edu,.two,.skills{grid-template-columns:1fr;gap:20px}
 nav{display:none}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<!-- MENU (à droite) -->
<nav class="top"><a href="mailto:TON-EMAIL@exemple.com">Mail</a></nav>
<nav id="menu">
  <a href="#hero">About</a>
  <a href="#skills">Skills</a>
  <a href="#work">Work</a>
  <a href="#tf1">Projets TF1</a>
  <a href="#canal">Projets CANAL+</a>
  <a href="#ecole">Projets École</a>
  <a href="#education">Education</a>
</nav>

<!-- HERO : mets ta photo dans le même dossier sous le nom photo-portrait.jpg -->
<section id="hero">
  <h1>Eugénie Berthon</h1>
  <h3>Social media manager / Monteuse</h3>
  <p>Social media manager et monteuse freelance, j'accompagne marques et créateurs dans la création de contenus qui racontent leur histoire.</p>
</section>

<!-- ABOUT -->
<section class="about">
  <div class="label bar">À propos d'Eugénie</div>
  <p style="margin-bottom:40px;color:var(--mut);letter-spacing:.1em;font-size:16px;text-transform:uppercase">Social media manager / Monteuse</p>
  <p style="margin-top:0">Diplômée d'un master 2 à l'EFAP, l'école des nouveaux métiers de la communication, en parcours 100% anglais, je suis déterminée, créative, curieuse et rigoureuse. Je crée et monte des contenus vidéo pour les réseaux sociaux, du tournage iPhone au montage sur Premiere Pro, en adaptant chaque format aux plateformes : LinkedIn, Instagram, TikTok.</p>
  <div class="quote">"Déterminée, créative, curieuse et rigoureuse."</div>
  <div class="two">
    <div><div class="label">TF1 - Boulogne-Billancourt / Orès Group - Paris</div>
      <p>Chez TF1, j'ai créé les vidéos des réseaux sociaux d'une Fondation : tournage, montage sur Premiere Pro et déclinaison des formats pour chaque plateforme. Auparavant, chez Orès Group à Paris, j'ai géré et modéré les réseaux sociaux de marques, en collaboration avec les équipes créatives sur la stratégie de contenu.</p></div>
    <div><div class="label">CANAL+ - Issy-les-Moulineaux / Topito - Paris</div>
      <p>Chez CANAL+, je créais les contenus des séries pour les réseaux sociaux, avec une planification stratégique des publications. Chez Topito, j'ai animé une communauté de plus de 3 millions d'abonnés sur Facebook, Twitter, Instagram et YouTube. Passionnée d'équitation, de piano et d'art en général, je nourris mon regard créatif au quotidien.</p></div>
  </div>
</section>

<!-- SKILLS -->
<section id="skills">
  <h2>Skills</h2>
  <div class="skills">
    <div>Social Media Management</div><div>Montage vidéo - Premiere Pro</div>
    <div>Suite Adobe</div><div>Création de contenus</div>
    <div>Tournage iPhone</div><div>Canva</div>
    <div>Community management &amp; modération</div><div>Formats courts - Instagram, TikTok, LinkedIn</div>
    <div>Planification &amp; programmation éditoriale</div><div>Reporting &amp; veille</div>
    <div>Anglais - C1 oral / B2 écrit</div><div>Espagnol - A2</div>
  </div>
</section>

<!-- WORK -->
<section id="work">
  <div class="label bar">Career</div>
  <h2>Work<br>Experience</h2>
  <div id="jobs"></div>
</section>

<!-- PROJETS : pour ajouter un projet, va dans le <script> tout en bas
     et complète la liste "PROJETS". -->
<section id="tf1">
  <div class="label">( Projets )</div>
  <h2>Fondation TF1</h2>
  <p class="intro">Une sélection de formats verticaux conçus et montés pour les réseaux sociaux de la Fondation TF1 : interviews, fact-checking et immersion dans les coulisses de l'info.</p>
  <div id="p-tf1"></div>
</section>

<section id="canal">
  <div class="label">( Projets )</div>
  <h2>CANAL+</h2>
  <p class="intro">Contenus créés pour les réseaux sociaux des séries CANAL+.</p>
  <div id="p-canal"></div>
</section>

<section id="ecole">
  <div class="label">( Projets )</div>
  <h2>Projets École</h2>
  <p class="intro">Travaux réalisés pendant mon master à l'EFAP : vidéo, communication et marketing.</p>
  <div id="p-ecole"></div>
</section>

<!-- EDUCATION -->
<section id="education">
  <div class="label bar">Background</div>
  <h2>Education</h2>
  <div class="edu"><div class="label">EFAP - Paris / France</div>
    <div><h4>Master Communication &amp; Marketing — Full English Track</h4>
    <p>École des nouveaux métiers de la communication. Marketing, communication, relations médias, montage vidéo et techniques rédactionnelles — cursus suivi à 100 % en anglais.</p><small>2021 — 2026</small></div></div>
  <div class="edu"><div class="label">Lycée International Winston Churchill - Londres / UK</div>
    <div><h4>Baccalauréat avec mention</h4>
    <p>Lycée International de Londres Winston Churchill. Spécialités : Histoire-Géopolitique, Sciences Économiques et Sociales, Littérature et Philosophie.</p><small>2018 — 2021</small></div></div>
</section>

<footer>© Eugénie Berthon — <a href="mailto:TON-EMAIL@exemple.com">TON-EMAIL@exemple.com</a></footer>

<script>
/* ---------- EXPÉRIENCES ---------- */
const JOBS=[
 {t:"Community Manager / Monteuse vidéo",c:"TF1",l:"Boulogne-Billancourt",d:"02.2026 — 09.2026",p:"Création de contenus vidéo engageants (2 vidéos par semaine) pour les réseaux sociaux de la Fondation, incluant tournage iPhone, montage sur Premiere Pro et adaptation des formats (LinkedIn, Instagram, TikTok).",tags:["Montage vidéo","Premiere Pro","Tournage iPhone","Réseaux sociaux","Formats courts"]},
 {t:"Assistante social media manager",c:"Orès Group",l:"Paris",d:"08.2024 — 12.2024",p:"Création de contenus engageants pour les plateformes digitales, en collaboration avec les équipes créatives selon la stratégie de marque. Gestion et modération des réseaux sociaux, planification et programmation des publications.",tags:["Social media","Création de contenus","Modération","Planification éditoriale"]},
 {t:"Créatrice de contenus digital pour les réseaux sociaux",c:"CANAL+",l:"Issy-les-Moulineaux",d:"08.2023 — 01.2024",p:"Création et partage de contenus pour les séries sur les réseaux sociaux, avec une planification stratégique des publications. Sélection des moments forts, production de vidéos et utilisation d'images pour créer des contenus accrocheurs.",tags:["Contenus séries","Production vidéo","Stratégie éditoriale","Réseaux sociaux"]},
 {t:"Community Manager",c:"Topito",l:"Paris",d:"01.2023 — 05.2023",p:"Management de la communauté (plus de 3 millions d'abonnés) du magazine web d'info-divertissement sur tous les réseaux sociaux (Facebook, Twitter, Instagram, YouTube). Suivi et reporting des performances.",tags:["Community management","Facebook","Twitter","Instagram","YouTube","Reporting"]},
 {t:"Assistante marketing",c:"Groupe Rocher (Petit Bateau, Natural Care)",l:"Paris",d:"04.2022 — 06.2022",p:"Soutien du Chef de Produit sur la coordination de projets de nouveaux lancements avec les équipes support. Analyse du marché, de la concurrence et des tendances. Veille réseaux sociaux, internet et blogs.",tags:["Marketing produit","Analyse marché","Veille","Coordination de projets"]}
];
document.getElementById('jobs').innerHTML=JOBS.map(j=>`
 <div class="job"><div><h4>${j.t}</h4><div class="co">${j.c}</div><div class="loc">${j.l}</div></div>
 <div class="date">${j.d}</div>
 <div><p>${j.p}</p><div class="tags">${j.tags.map(x=>`<span>${x}</span>`).join('')}</div></div></div>`).join('');

/* ---------- PROJETS : ICI TU AJOUTES TES CONTENUS ----------
 Chaque projet = { legende, type, src }
   type "image"   → src = "mon-image.jpg" (vertical 9:16)
   type "video"   → src = "ma-video.mp4"  (vertical 9:16)
   type "youtube" → src = "https://www.youtube.com/embed/ID_DE_LA_VIDEO"
   type "image-h" / "video-h" / "youtube-h" → même chose en format horizontal 16:9
 Chaque série = { nom, items:[ ... ] }
 Copie-colle une ligne { ... } pour ajouter un projet.
 Copie-colle un bloc { nom:..., items:[...] } pour ajouter une série.
------------------------------------------------------------ */
const PROJETS={
 tf1:[
  {nom:"L'interview SPEEEEED — Des Boursiers de la Réussite",items:[
   {legende:"Lucie Algénir — Future productrice",type:"image",src:""},
   {legende:"Cynthia Lawson — Future ingénieure du son",type:"image",src:""},
   {legende:"Lorenzo Govi-Bartolomei — Futur journaliste",type:"image",src:""},
   {legende:"Selim Krouchi — Futur journaliste",type:"image",src:""}
  ]},
  {nom:"Les Verifs Top Chrono",items:[
   {legende:"Titre de la vidéo",type:"video",src:""}
  ]}
 ],
 canal:[
  {nom:"Contenus séries CANAL+",items:[
   {legende:"Nom de la série — type de contenu",type:"video",src:""},
   {legende:"Nom de la série — type de contenu",type:"video",src:""},
   {legende:"Nom de la série — type de contenu",type:"image",src:""}
  ]}
 ],
 ecole:[
  {nom:"Projets EFAP",items:[
   {legende:"Nom du projet — matière / année",type:"image-h",src:""},
   {legende:"Nom du projet — matière / année",type:"video-h",src:""}
  ]}
 ]
};

function media(it){
 const h=it.type.endsWith('-h'), k=it.type.replace('-h','');
 let inner='Ajoute ton contenu<br>(src vide)';
 if(it.src){
  if(k==='image') inner=`<img src="${it.src}" alt="${it.legende}" loading="lazy">`;
  else if(k==='video') inner=`<video src="${it.src}" controls playsinline preload="metadata"></video>`;
  else if(k==='youtube') inner=`<iframe src="${it.src}" allowfullscreen loading="lazy" title="${it.legende}"></iframe>`;
 }
 return `<figure class="card ${h?'h':''}"><figure>${inner}</figure><figcaption>${it.legende}</figcaption></figure>`;
}
Object.keys(PROJETS).forEach(k=>{
 document.getElementById('p-'+k).innerHTML=PROJETS[k].map(s=>`
  <div class="serie"><h5>${s.nom}</h5><div class="grid">
  ${s.items.map(it=>{const h=it.type.endsWith('-h');const m=media(it);
   return `<div class="card ${h?'h':''}">${m.replace(/^<figure class="card[^"]*">/,'').replace(/<\/figure>$/,'')}</div>`}).join('')}
  </div></div>`).join('');
});

/* ---------- MENU actif au scroll ---------- */
const links=[...document.querySelectorAll('#menu a')];
const ids=links.map(a=>document.querySelector(a.getAttribute('href')));
addEventListener('scroll',()=>{
 let i=0;ids.forEach((s,n)=>{if(s.getBoundingClientRect().top<innerHeight/2)i=n});
 links.forEach((a,n)=>a.classList.toggle('on',n===i));
},{passive:true});
</script>
</body>
</html>
